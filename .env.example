# Không đưa file .env thật lên Git. Thay giá trị dưới đây khi triển khai.

# ICU Predict
SECRET_KEY=thay-bang-mot-chuoi-ngau-nhien-dai
# Trong Supabase chọn Connect -> Session pooler. Đây là loại tương thích Render
# (IPv4) và cần có sslmode=require trong chuỗi kết nối.
DATABASE_URL=postgresql://postgres.[project-ref]:[mat-khau-db]@aws-[region].pooler.supabase.com:5432/postgres?sslmode=require
ICU_PREDICT_ADMIN_USERNAME=admin
ICU_PREDICT_ADMIN_PASSWORD=doi-mat-khau-nay
ICU_PREDICT_DEMO_MODE=false
SESSION_COOKIE_SECURE=true
ICU_LICENSE_ENFORCEMENT_ENABLED=true
ICU_LICENSE_KEY=ICU-XXXXXX-XXXXXX-XXXXXX-XXXXXX
LICENSE_VALIDATION_URL=https://license-admin.ten-mien-cua-ban.com/api/v1/licenses/validate
ICU_INTEGRATION_SHARED_SECRET=mot-bi-mat-chung-dai-va-ngau-nhien
ICU_LICENSE_CLIENT_ID=icu-predict-production
# Chỉ dùng đường dẫn SQLite này khi chạy cục bộ. Khi online, hai ứng dụng dùng
# chung DATABASE_URL ở trên.
LICENSE_ADMIN_DATABASE_PATH=/duong-dan-bao-mat/toi/license_admin.db
PAYMENT_BANK_NAME=Ten-ngan-hang-thu-huong-da-xac-minh
PAYMENT_BANK_CODE=TPBank
PAYMENT_ACCOUNT_NUMBER=so-tai-khoan-da-xac-minh
PAYMENT_ACCOUNT_NAME=ten-chu-tai-khoan-da-xac-minh

# License Admin
LICENSE_ADMIN_SECRET_KEY=mot-bi-mat-session-khac-dai-va-ngau-nhien
LICENSE_ADMIN_USERNAME=license_admin
LICENSE_ADMIN_PASSWORD=doi-mat-khau-nay
LICENSE_ADMIN_DEMO_MODE=false
BANK_WEBHOOK_SECRET=bi-mat-webhook-do-ngan-hang-cung-cap

# SePay: chọn HMAC-SHA256 lúc tạo webhook và chỉ đặt secret này trong
# Environment của hosting. Tuyệt đối không đưa secret thật vào source/Git.
SEPAY_WEBHOOK_SECRET=secret-hmac-tu-sepay
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300
